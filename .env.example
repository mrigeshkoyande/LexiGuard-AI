# ==============================================================================
# LexiGuard AI — Environment Configuration & Deployment Variables
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port
PORT=5000

# Client URL (for CORS and cookie origin in production)
CLIENT_URL=http://localhost:5000

# JWT Authentication Secret (Use a secure random string in production, 32+ characters)
JWT_SECRET=lexiguard_production_secret_key_change_in_production_32_chars_min
JWT_EXPIRES_IN=7d

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# AI Inference Provider:
# - 'mock': Deterministic, 100% offline, zero-latency, zero-cost, source-grounded contract analysis (Recommended default)
# - 'gemini': Google Gemini 1.5 Pro inference engine
# - 'anthropic': Anthropic Claude 3.5 Sonnet legal analysis engine
# - 'real' / 'openai': OpenAI GPT-4o / GPT-4o-mini engine
AI_PROVIDER=mock

# AI API Keys (Optional — only required if AI_PROVIDER is not 'mock')
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Compliance
ZERO_RETENTION_TELEMETRY=true
COOKIE_SECURE=false # Set to true when serving behind HTTPS/TLS
