# ==============================================================================
# LexiGuard AI Environment Configuration
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client URL (for CORS and cookie origin in production)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret (Use a secure random string in production)
JWT_SECRET=lexiguard_dev_secret_key_change_in_production_32_chars_min

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# AI Provider: 'mock' (default, offline, zero-cost) or 'real' (requires OPENAI_API_KEY)
AI_PROVIDER=mock

# Real AI Provider Configuration (Optional - only required if AI_PROVIDER=real)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
