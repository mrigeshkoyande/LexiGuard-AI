{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lexiguard/shared": ["shared/src/index.ts"]
    }
  },
  "include": ["api/**/*", "server/src/**/*", "shared/src/**/*"]
}
