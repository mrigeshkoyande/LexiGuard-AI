# Dependencies
node_modules/
.pnp
.pnp.js

# Build and production outputs
dist/
build/
out/
graphify-out/
.next/
*.tsbuildinfo

# Exception: shared/dist must be committed so Vercel can resolve @lexiguard/shared
!shared/dist/
!shared/dist/**

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Databases & SQLite
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal

# Uploads and temporary files
server/uploads/*
!server/uploads/.gitkeep
uploads/
tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
